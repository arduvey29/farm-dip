{
  "name": "ghee",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fonts": "node scripts/fetch-fonts.mjs",
    "predev": "node scripts/fetch-fonts.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/fetch-fonts.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "node scripts/fetch-fonts.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "favicons": "node scripts/build-favicons.mjs",
    "theme:build": "node scripts/fetch-fonts.mjs && node scripts/build-theme.mjs",
    "theme:templates": "node scripts/theme-templates.mjs",
    "theme:check": "npm run theme:build && shopify theme check --path shopify",
    "theme:dev": "npm run theme:build && shopify theme dev --path shopify",
    "theme:push": "npm run theme:build && shopify theme push --path shopify --unpublished",
    "shopify:setup": "node scripts/shopify-setup.mjs",
    "theme:upload": "node scripts/shopify-theme-upload.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
