      { "type": "number", "id": "return_days", "label": "Quality promise (days)", "default": 7 },
      { "type": "number", "id": "milk_per_litre", "label": "Litres of buffalo milk per litre of ghee", "info": "Used in \"What goes into one pack\" on the product page.", "default": 14 }
