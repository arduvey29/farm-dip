<!doctype html>
<html lang="en-IN" class="h-full antialiased">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#fff8e8">
    <link rel="icon" type="image/svg+xml" href="{{ 'farm-dip-emblem.svg' | asset_url }}">
    <title>{{ shop.name }} | Opening soon</title>
    {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ 'farm-dip.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="flex min-h-full flex-col">
    <main id="main" class="flex-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
