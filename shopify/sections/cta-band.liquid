{%- comment -%} Closing call to action on a band of ghee. {%- endcomment -%}
{%- liquid
  assign product = section.settings.product | default: all_products['pure-desi-buffalo-ghee']
  assign shop_url = section.settings.button_link | default: product.url | default: routes.all_products_collection_url
-%}
<section class="bg-ghee-400 text-ink-950" aria-labelledby="cta-{{ section.id }}">
  <div class="wrap flex flex-col items-start justify-between gap-5 py-8 sm:flex-row sm:items-center sm:py-9 lg:py-10">
    <div>
      <h2 id="cta-{{ section.id }}" class="font-display text-3xl font-bold leading-tight sm:text-4xl lg:text-[2.5rem]">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="mt-1.5 text-sm text-ink-800 sm:text-base">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    <div class="flex flex-wrap items-center gap-3 shrink-0">
      <a href="{{ shop_url }}" class="inline-flex items-center justify-center rounded-full bg-ink-950 px-6 py-2.5 text-sm font-bold text-cream shadow-sm transition-all hover:bg-ink-900 active:scale-95 sm:text-base">{{ section.settings.button_label }}</a>
      {%- if section.settings.show_whatsapp -%}
        <a href="https://wa.me/{{ settings.whatsapp }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-full border border-ink-950 bg-transparent px-6 py-2.5 text-sm font-bold text-ink-950 transition-all hover:bg-ink-950/10 active:scale-95 sm:text-base">Order on WhatsApp</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call to action band",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring home a jar." },
    { "type": "text", "id": "text", "label": "Text", "default": "500 ml, 1 L or a 5 L jar. Free cash on delivery across India." },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop ghee" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_whatsapp", "label": "Show \"Order on WhatsApp\"", "default": true }
  ],
  "presets": [{ "name": "Call to action band" }]
}
{% endschema %}
