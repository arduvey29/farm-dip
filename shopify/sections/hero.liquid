{%- comment -%}
  Two layouts:
    video  the brand video (9:16) beside Rani's animated scene, used on the home page
    text   the headline, buttons and promises beside Rani's scene, used on Our story
  The price disc shows the lowest price of the chosen product.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product | default: all_products['pure-desi-buffalo-ghee']
  assign shop_url = section.settings.button_link | default: product.url | default: routes.all_products_collection_url
-%}
{%- capture price_disc -%}
  {%- if product != blank -%}
    <span class="leading-tight">
      <span class="block text-[0.62rem] text-ghee-300 sm:text-xs">from</span>
      <span class="block font-display text-lg sm:text-xl lg:text-2xl">{{ product.price_min | money_without_currency | remove: '.00' | prepend: '₹' }}</span>
    </span>
  {%- endif -%}
{%- endcapture -%}

{%- if section.settings.layout == 'video' -%}
  <section class="relative overflow-hidden" aria-label="{{ shop.name }} video">
    <div class="wrap grid items-center justify-items-center gap-8 pt-16 pb-12 sm:pt-20 sm:pb-16 lg:pt-24 lg:pb-20 md:grid-cols-2 lg:gap-14">
      <div class="flex w-full justify-center">
        <div class="relative mx-auto w-full max-w-[17rem] sm:max-w-[19rem] lg:max-w-[21rem]" data-video>
          <div class="pointer-events-none absolute -inset-4 -z-10 rounded-[2.5rem] bg-ghee-300/30 blur-2xl" aria-hidden="true"></div>
          <div class="group relative aspect-[9/16] w-full overflow-hidden rounded-[2rem] border-2 border-line/80 bg-ink-950 shadow-2xl transition-all duration-300 hover:shadow-[0_24px_50px_-12px_rgba(235,168,38,0.35)]">
            {%- if section.settings.video != blank -%}
              {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'auto', class: 'size-full object-cover', image_size: '720x' }}
            {%- else -%}
              <video src="{{ 'farm-dip-video.mp4' | asset_url }}" autoplay loop muted playsinline preload="auto" class="size-full object-cover"></video>
            {%- endif -%}
            <button type="button" data-video-toggle data-muted aria-label="Unmute video" class="group/vt absolute right-3.5 bottom-3.5 z-20 flex size-9 items-center justify-center rounded-full bg-ink-950/75 text-cream backdrop-blur-md transition-all hover:scale-110 hover:bg-ink-950 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-ghee-400 border border-white/20">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden size-4 text-ghee-300 group-data-[muted]/vt:block" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block size-4 text-ghee-400 group-data-[muted]/vt:hidden" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
            </button>
          </div>
        </div>
      </div>

      <div class="hidden md:block relative mx-auto w-full max-w-[21rem] sm:max-w-[24rem] lg:max-w-[27rem]">
        {% render 'hero-scene' %}
        {%- if price_disc != blank -%}
          <p class="absolute top-[6%] right-0 grid size-18 place-items-center rounded-full bg-ink-900 text-center text-cream shadow-md sm:size-20 lg:size-22">{{ price_disc }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- else -%}
  <section class="relative overflow-hidden" aria-labelledby="hero-title-{{ section.id }}">
    <div class="wrap grid items-center gap-8 pt-4 pb-10 sm:pt-6 sm:pb-14 lg:pt-8 lg:pb-16 lg:grid-cols-[1.12fr_0.88fr] lg:gap-14">
      <div class="relative">
        <div class="pointer-events-none absolute -inset-8 -z-10 opacity-[0.06]" style="background-image: radial-gradient(circle at 1px 1px, var(--color-ink-950) 1.2px, transparent 0), radial-gradient(circle at 14px 14px, var(--color-ghee-600) 1.5px, transparent 0); background-size: 28px 28px" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -top-16 -left-16 size-80 rounded-full bg-ghee-300/30 blur-3xl" aria-hidden="true"></div>
        <h1 id="hero-title-{{ section.id }}" class="font-deva text-4xl font-bold leading-[1.04] text-ink-950 tracking-tight sm:text-5xl lg:text-[3.75rem] xl:text-[4.25rem]">
          {{ section.settings.heading }}
          <span class="relative inline-block whitespace-nowrap">
            <span class="relative z-10 font-bold text-ghee-800">{{ section.settings.heading_accent }}</span>
            <svg class="absolute -bottom-1.5 left-0 -z-0 h-3 w-full text-ghee-400" viewBox="0 0 140 12" fill="none" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8.5C35 2 85 11 138 4" stroke="currentColor" stroke-width="5.5" stroke-linecap="round"/></svg>
          </span>
        </h1>
        <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-4">
          <a href="{{ shop_url }}" class="btn btn-ink min-h-[3.25rem] sm:min-h-14 px-8 text-base sm:text-lg font-bold shadow-md transition-transform duration-200 hover:scale-[1.02]">{{ section.settings.button_label }}</a>
          {%- if section.settings.button2_label != blank -%}
            <a href="{{ section.settings.button2_link | default: '/pages/how-its-made' }}" class="btn btn-line min-h-[3.25rem] sm:min-h-14 border-ink-300 px-7 text-base sm:text-lg font-semibold text-ink-950 transition-colors hover:border-ink-900">{{ section.settings.button2_label }}</a>
          {%- endif -%}
        </div>
        <ul class="mt-8 sm:mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-xs font-medium text-ink-800 sm:text-sm">
          <li class="inline-flex items-center gap-2">{% render 'icon', name: 'leaf', class: 'size-4 text-pasture-700' %}<span>No preservatives or additives</span></li>
          <li class="inline-flex items-center gap-2">{% render 'icon', name: 'cash', class: 'size-4 text-ghee-800' %}<span>Free cash on delivery</span></li>
          <li class="inline-flex items-center gap-2">{% render 'icon', name: 'truck', class: 'size-4 text-pasture-700' %}<span>Ships in {{ settings.dispatch_hours }} hours</span></li>
        </ul>
      </div>
      <div class="relative mx-auto w-full max-w-[28rem] lg:max-w-[31rem]">
        {% render 'hero-scene' %}
        {%- if price_disc != blank -%}
          <p class="absolute top-[8%] right-0 grid size-20 place-items-center rounded-full bg-ink-900 text-center text-cream shadow-[0_14px_30px_-14px_rgb(22_17_19/0.7)] sm:size-24">{{ price_disc }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "video", "label": "Video beside Rani" }, { "value": "text", "label": "Headline beside Rani" } ], "default": "video" },
    { "type": "product", "id": "product", "label": "Product for the price disc" },
    { "type": "header", "content": "Video layout" },
    { "type": "video", "id": "video", "label": "Video", "info": "Upload in Content > Files. Leave empty to use the video that ships with the theme." },
    { "type": "header", "content": "Headline layout" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ghee the way we ate it" },
    { "type": "text", "id": "heading_accent", "label": "Heading, underlined part", "default": "as children." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop ghee" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button", "default": "See how it's made" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
