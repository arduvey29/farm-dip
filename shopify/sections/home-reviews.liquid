{%- comment -%}
  "What families say": a heading and rating summary that open a row of quotes (swipeable on phones).
  Each review is a block. If you install a reviews app (for example Judge.me), add its block to the
  product page and keep this section for chosen quotes.
{%- endcomment -%}
{%- liquid
  assign total = 0
  for block in section.blocks
    assign total = total | plus: block.settings.rating
  endfor
  assign count = section.blocks.size
  if count > 0
    assign average = total | times: 1.0 | divided_by: count | round: 1
  endif
  assign list_id = 'reviews-' | append: section.id
-%}
<section id="{{ list_id }}" class="group/rev bg-oat transition-all duration-300" aria-labelledby="{{ list_id }}-title">
  <div class="wrap transition-all duration-300 py-8 sm:py-10 lg:py-12 group-data-[open]/rev:py-12 sm:group-data-[open]/rev:py-14 lg:group-data-[open]/rev:py-20">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <button type="button" data-toggle-target="{{ list_id }}" aria-expanded="false" aria-controls="{{ list_id }}-list" class="cursor-pointer select-none text-left transition-opacity hover:opacity-85">
          <h2 id="{{ list_id }}-title" class="font-display leading-[1.04] text-balance text-2xl sm:text-3xl text-ink-900">{{ section.settings.title }}</h2>
        </button>
        <button type="button" data-toggle-target="{{ list_id }}" aria-expanded="false" aria-controls="{{ list_id }}-list" aria-label="Show customer reviews" class="grid size-9 sm:size-10 shrink-0 place-items-center rounded-full border border-line bg-milk text-ink-900 shadow-xs transition-all duration-300 hover:border-ghee-500 hover:bg-ghee-200 hover:scale-105 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-ghee-500 group-data-[open]/rev:rotate-180 group-data-[open]/rev:bg-ghee-400 group-data-[open]/rev:text-ink-950 group-data-[open]/rev:border-ghee-500 group-data-[open]/rev:shadow-sm">
          {% render 'icon', name: 'chevronDown', class: 'size-4 sm:size-5 transition-transform duration-300' %}
        </button>
      </div>
      {%- if count > 0 -%}
        <button type="button" data-toggle-target="{{ list_id }}" class="flex cursor-pointer items-center gap-2 text-sm select-none transition-opacity hover:opacity-85">
          {% render 'stars', rating: average, class: 'size-4' %}
          <span class="font-semibold">{{ average }} out of 5</span>
          <span class="text-ink-700">from {{ section.settings.review_count | default: count }} reviews</span>
        </button>
      {%- endif -%}
    </div>

    <div id="{{ list_id }}-list" class="grid transition-all duration-500 ease-in-out grid-rows-[0fr] opacity-0 mt-0 pointer-events-none group-data-[open]/rev:grid-rows-[1fr] group-data-[open]/rev:opacity-100 group-data-[open]/rev:mt-8 group-data-[open]/rev:pointer-events-auto">
      <div class="overflow-hidden">
        <ul class="-mx-4 flex snap-x snap-mandatory gap-6 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-10 sm:overflow-visible sm:px-0 sm:pb-0">
          {%- for block in section.blocks -%}
            <li class="w-[80%] shrink-0 snap-start sm:w-auto" {{ block.shopify_attributes }}>
              <figure class="flex h-full flex-col border-l-2 border-ghee-400 pl-4">
                {% render 'stars', rating: block.settings.rating, class: 'size-4' %}
                <blockquote class="mt-3 text-sm leading-relaxed text-ink-800 sm:text-base">&ldquo;{{ block.settings.body }}&rdquo;</blockquote>
                <figcaption class="mt-auto pt-4 text-xs font-semibold text-ink-700">{{ block.settings.author }}, {{ block.settings.city }}</figcaption>
              </figure>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "What families say" },
    { "type": "number", "id": "review_count", "label": "Total number of reviews", "info": "Shown beside the stars. Leave empty to count the quotes below." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "body", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Name" },
        { "type": "text", "id": "city", "label": "City" }
      ]
    }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
