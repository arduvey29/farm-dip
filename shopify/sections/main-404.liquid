{%- comment -%} Page not found. {%- endcomment -%}
<section class="wrap grid items-center gap-10 py-16 lg:grid-cols-2 lg:py-24">
  <div>
    <p class="font-display text-7xl text-ghee-500">404</p>
    <h1 class="mt-2 font-display text-4xl leading-[1.05] sm:text-5xl">{{ section.settings.heading }}</h1>
    <p class="mt-4 max-w-lg text-lg text-ink-800">{{ section.settings.text }}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="{{ routes.root_url }}" class="btn btn-ink">Go home</a>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-line">Shop ghee</a>
    </div>
  </div>
  <div class="mx-auto w-full max-w-md">{% render 'hero-scene' %}</div>
</section>

{% schema %}
{
  "name": "Page not found",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rani has wandered off to graze." },
    { "type": "text", "id": "text", "label": "Text", "default": "This page is not here. The ghee is, though." }
  ]
}
{% endschema %}
