{%- comment -%}
  The shop page (collections/all and any collection): every pack size of every product as a size card,
  in view on the first screen. The longer guide below it is the "Shop page guide" section.
{%- endcomment -%}
<div class="wrap pt-2 sm:pt-3">
  <nav aria-label="Breadcrumb" class="text-sm text-ink-700">
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <li class="flex items-center gap-2"><a href="{{ routes.root_url }}" class="underline-offset-4 hover:underline">Home</a><span aria-hidden="true" class="text-brass">/</span></li>
      <li class="flex items-center gap-2"><span aria-current="page" class="text-ink-900">Shop</span></li>
    </ol>
  </nav>
</div>

<section class="wrap pt-2 pb-6 sm:pt-3 sm:pb-8 lg:pt-3 lg:pb-10">
  <div class="flex flex-col gap-2 border-b border-line/70 pb-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 sm:pb-3.5">
    <h1 class="font-display text-3xl font-bold leading-tight text-ink-950 sm:text-4xl lg:text-[2.75rem]">{{ section.settings.heading | default: collection.title }}</h1>
    <div class="flex flex-wrap items-center gap-2 text-xs text-ink-700 sm:justify-end">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-oat/90 px-3 py-1 font-medium text-ink-900">{% render 'icon', name: 'truck', class: 'size-3.5 text-pasture-700' %}{{ section.settings.chip_1 }}</span>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-oat/90 px-3 py-1 font-medium text-ink-900">{% render 'icon', name: 'cash', class: 'size-3.5 text-ghee-800' %}{{ section.settings.chip_2 }}</span>
    </div>
  </div>

  {%- paginate collection.products by 12 -%}
    <div class="mt-4 grid grid-cols-1 gap-4 sm:mt-5 sm:grid-cols-2 lg:grid-cols-3 sm:gap-6">
      {%- for product in collection.products -%}
        {%- for variant in product.variants -%}
          {%- liquid
            assign size = product.variants.size
            assign badge = ''
            assign style = 'light'
            if forloop.last and size > 1
              assign badge = section.settings.badge_last
              assign style = 'ink'
            elsif forloop.index == 2
              assign badge = section.settings.badge_middle
              assign style = 'green'
            elsif forloop.first
              assign badge = section.settings.badge_first
            endif
          -%}
          <div class="animate-product-rise" style="animation-delay: {{ forloop.index0 | times: 120 }}ms">
            {% render 'size-card', product: product, variant: variant, badge: badge, badge_style: style, packaging: section.settings.packaging, compact: true, eager: true, heading: 'h2' %}
          </div>
        {%- endfor -%}
      {%- else -%}
        <p class="text-ink-700">No products here yet.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="mt-8 flex justify-center gap-4" aria-label="Pages">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Products",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy buffalo ghee", "info": "Leave empty to use the collection's title." },
    { "type": "text", "id": "chip_1", "label": "First promise", "default": "Free shipping above ₹999" },
    { "type": "text", "id": "chip_2", "label": "Second promise", "default": "Free cash on delivery" },
    { "type": "text", "id": "packaging", "label": "Packaging label", "default": "Jar" },
    { "type": "text", "id": "badge_first", "label": "Badge on the smallest size", "default": "Daily size" },
    { "type": "text", "id": "badge_middle", "label": "Badge on the middle size", "default": "Most popular" },
    { "type": "text", "id": "badge_last", "label": "Badge on the largest size", "default": "Best value" }
  ]
}
{% endschema %}
