{%- comment -%} The page visitors see while the store is password protected. {%- endcomment -%}
<section class="wrap grid min-h-svh items-center gap-10 py-12 lg:grid-cols-2">
  <div>
    <div class="flex items-center gap-3">
      {% render 'logo-mark', class: 'h-16 w-auto' %}
      <span class="font-caslon text-4xl font-bold">{{ shop.name }}</span>
    </div>
    <h1 class="mt-8 font-display text-4xl leading-[1.05] sm:text-5xl">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="mt-4 max-w-lg text-lg text-ink-800">{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'mt-8 max-w-md' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="rounded-xl bg-pasture-100 px-4 py-3 text-sm font-semibold text-pasture-900" role="status">Thank you. We will write when the store opens.</p>
      {%- else -%}
        <label for="password-email" class="mb-1.5 block text-sm font-semibold">Get a message when we open</label>
        <div class="flex gap-2">
          <input id="password-email" type="email" name="contact[email]" required autocomplete="email" placeholder="name@email.com" class="min-h-12 flex-1 rounded-full border border-ink-200 bg-white px-4">
          <button type="submit" class="btn btn-gold">Notify me</button>
        </div>
        {%- if form.errors -%}<p class="mt-2 text-sm text-spice">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}

    <details class="mt-10 max-w-md">
      <summary class="cursor-pointer text-sm font-semibold underline underline-offset-4">Enter with a password</summary>
      {%- form 'storefront_password', class: 'mt-4 flex gap-2' -%}
        <label for="store-password" class="sr-only">Password</label>
        <input id="store-password" type="password" name="password" autocomplete="current-password" class="min-h-12 flex-1 rounded-full border border-ink-200 bg-white px-4">
        <button type="submit" class="btn btn-ink">Enter</button>
        {%- if form.errors -%}<p class="mt-2 text-sm text-spice">Wrong password.</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
  <div class="mx-auto w-full max-w-md">{% render 'hero-scene' %}</div>
</section>

{% schema %}
{
  "name": "Opening soon",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pure desi buffalo ghee. Opening soon." }
  ]
}
{% endschema %}
