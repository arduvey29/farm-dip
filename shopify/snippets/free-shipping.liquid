{%- comment -%} Free-shipping progress for the cart. `threshold` is in rupees. {%- endcomment -%}
{%- liquid
  assign threshold_paise = threshold | times: 100
  assign remaining = threshold_paise | minus: cart.total_price
  assign pct = cart.total_price | times: 100 | divided_by: threshold_paise
  if pct > 100
    assign pct = 100
  endif
-%}
<div>
  <p class="text-sm" aria-live="polite">
    {%- if remaining <= 0 -%}
      <span class="font-semibold text-pasture-600">Your order ships free.</span>
    {%- else -%}
      Add <strong>{{ remaining | money_without_currency | remove: '.00' | prepend: '₹' }}</strong> more for free shipping.
    {%- endif -%}
  </p>
  <div class="mt-2 h-2 overflow-hidden rounded-full bg-line" role="progressbar" aria-label="Progress to free shipping" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}">
    <div class="h-full rounded-full bg-ghee-500 transition-[width] duration-500" style="width: {{ pct }}%"></div>
  </div>
</div>
