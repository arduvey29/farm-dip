{%- comment -%}
  Molten ghee dripping off the bottom edge of a band. Render it as the last child of a
  `relative` section whose background is the drip colour. The drips grow as the band scrolls up the
  screen (initMotion() drives [data-progress]; CSS "Ghee drips" in farm-dip.css).
  Usage: {% render 'ghee-drip' %}  or  {% render 'ghee-drip', color: 'var(--color-pasture-900)' %}
{%- endcomment -%}
<div class="drip" data-progress data-progress-start="1" data-progress-end="0.2" data-progress-still="0.55" style="--drip: {{ color | default: 'var(--color-ghee-400)' }}" aria-hidden="true">
  <svg class="drip-wave" viewBox="0 0 1440 28" preserveAspectRatio="none" focusable="false">
    <path d="M0 0H1440V12C1384 22 1330 24 1262 16S1120 4 1044 13 902 27 818 19 676 6 598 14 452 26 376 18 236 6 166 13 44 23 0 15Z" fill="currentColor"/>
  </svg>
  <span class="drip-drop" style="left: 5%; --w: 10px; --len: 18px"></span>
  <span class="drip-drop" data-falls style="left: 12%; --w: 14px; --len: 30px"></span>
  <span class="drip-drop" style="left: 21%; --w: 9px; --len: 16px"></span>
  <span class="drip-drop" style="left: 29%; --w: 12px; --len: 24px"></span>
  <span class="drip-drop" data-falls style="left: 40%; --w: 16px; --len: 36px"></span>
  <span class="drip-drop" style="left: 49%; --w: 9px; --len: 17px"></span>
  <span class="drip-drop" style="left: 58%; --w: 13px; --len: 26px"></span>
  <span class="drip-drop" style="left: 68%; --w: 10px; --len: 20px"></span>
  <span class="drip-drop" data-falls style="left: 77%; --w: 15px; --len: 32px"></span>
  <span class="drip-drop" style="left: 86%; --w: 9px; --len: 15px"></span>
  <span class="drip-drop" style="left: 94%; --w: 12px; --len: 24px"></span>
</div>
