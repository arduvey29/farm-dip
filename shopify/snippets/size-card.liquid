{%- comment -%}
  One pack size of the ghee as a card (the store sells one ghee in three sizes, so shoppers pick a size).
  Usage: {% render 'size-card', product: product, variant: variant, badge: 'Best value', badge_style: 'ink',
         packaging: 'Jar', compact: true, eager: true, image_class: 'h-40 object-contain p-2', heading: 'h3' %}
  badge_style: ink | green | light
{%- endcomment -%}
{%- liquid
  assign heading = heading | default: 'h3'
  capture ml
    render 'variant-volume', variant: variant
  endcapture
  assign ml = ml | strip | plus: 0
  assign per_litre = variant.price | times: 1000 | divided_by: ml

  assign highest = 0
  for v in product.variants
    capture v_ml
      render 'variant-volume', variant: v
    endcapture
    assign v_ml = v_ml | strip | plus: 0
    assign v_pl = v.price | times: 1000 | divided_by: v_ml
    if v_pl > highest
      assign highest = v_pl
    endif
  endfor
  assign saving = 0
  if highest > 0
    assign saving = highest | minus: per_litre | times: 100.0 | divided_by: highest | round
  endif

  assign off = 0
  if variant.compare_at_price > variant.price
    assign off = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
  endif

  assign image = variant.featured_image | default: product.featured_image
  if compact
    assign default_image_class = 'h-52 sm:h-56 lg:h-60'
  else
    assign default_image_class = 'aspect-square sm:aspect-[4/5]'
  endif
  if image_class != blank
    assign default_image_class = image_class
  endif
  assign img_class = 'w-full object-cover transition-transform duration-500 group-hover:scale-[1.05] ' | append: default_image_class
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
-%}
<article class="group flex flex-col rounded-[1.25rem] bg-milk shadow-md transition-all duration-300 hover:shadow-2xl hover:border-ghee-400 hover:-translate-y-1 border border-line/80 {% if compact %}p-2 sm:rounded-[1.65rem] sm:p-3{% else %}p-2 sm:rounded-[1.75rem] sm:p-3{% endif %}">
  <a href="{{ variant.url }}" class="relative block overflow-hidden rounded-[1rem] bg-oat/70 sm:rounded-[1.35rem]" tabindex="-1" aria-hidden="true">
    {%- if image -%}
      {{ image | image_url: width: 720 | image_tag: alt: '', loading: loading, sizes: '(min-width: 1024px) 360px, 48vw', widths: '240, 360, 480, 720', class: img_class }}
    {%- else -%}
      <img src="{{ fallback_image | default: 'ghee-jar.svg' | asset_url }}" alt="" width="600" height="600" class="{{ img_class }}" loading="{{ loading }}">
    {%- endif -%}
    {%- if badge != blank -%}
      {%- case badge_style -%}
        {%- when 'ink' -%}{%- assign badge_class = 'bg-ink-950 text-ghee-300 shadow-md' -%}
        {%- when 'green' -%}{%- assign badge_class = 'bg-pasture-800 text-cream shadow-md' -%}
        {%- else -%}{%- assign badge_class = 'bg-milk/95 text-ink-800 shadow-sm backdrop-blur-xs' -%}
      {%- endcase -%}
      <span class="absolute top-2 left-2 rounded-full px-2 py-0.5 text-[0.62rem] font-bold sm:top-2.5 sm:left-2.5 sm:px-3 sm:py-1 sm:text-[0.72rem] {{ badge_class }}">{{ badge }}</span>
    {%- endif -%}
  </a>

  <div class="flex flex-1 flex-col {% if compact %}px-1.5 pt-2.5 pb-1 sm:px-2.5 sm:pt-3.5{% else %}px-1.5 pt-2.5 pb-1 sm:px-3 sm:pt-4 sm:pb-2{% endif %}">
    <div class="flex items-baseline justify-between gap-1.5">
      <{{ heading }} class="font-display font-bold leading-none text-ink-950 {% if compact %}text-base sm:text-xl lg:text-2xl{% else %}text-lg sm:text-2xl md:text-[1.85rem]{% endif %}">
        <a href="{{ variant.url }}" class="underline-offset-4 group-hover:underline">
          {{ variant.title }}<span class="sr-only"> {{ product.title }}</span>
        </a>
      </{{ heading }}>
      {%- if packaging != blank -%}
        <span class="text-[0.7rem] font-semibold text-ink-600 sm:text-sm">{{ packaging }}</span>
      {%- endif -%}
    </div>

    <div class="mt-auto pt-2 sm:pt-3">
      <div class="flex flex-wrap items-baseline justify-between gap-1">
        <span class="inline-flex flex-wrap items-baseline gap-x-2">
          <span class="text-lg font-bold">{{ variant.price | money_without_currency | remove: '.00' | prepend: '₹' }}</span>
          {%- if off > 0 -%}
            <s class="text-sm text-ink-500" aria-label="MRP {{ variant.compare_at_price | money_without_currency | remove: '.00' | prepend: '₹' }}">{{ variant.compare_at_price | money_without_currency | remove: '.00' | prepend: '₹' }}</s>
            <span class="text-sm font-semibold text-spice">{{ off }}% off</span>
          {%- endif -%}
        </span>
        {%- if saving > 0 -%}
          <span class="rounded-md bg-pasture-100/90 px-1.5 py-0.2 text-[0.68rem] font-bold text-pasture-900 sm:px-2 sm:py-0.5 sm:text-xs">Save {{ saving }}%</span>
        {%- endif -%}
      </div>
      <p class="mt-0.5 text-[0.7rem] font-medium text-ink-600 sm:text-xs">{{ per_litre | money_without_currency | remove: '.00' | prepend: '₹' }} / litre</p>
    </div>

    <form method="post" action="{{ routes.cart_add_url }}" data-product-form>
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button
        type="submit"
        class="btn btn-gold w-full px-2 font-bold aria-busy:opacity-70 disabled:opacity-50 {% if compact %}mt-2 min-h-8 py-1.5 text-xs sm:mt-2.5 sm:min-h-9 sm:text-sm{% else %}mt-2.5 min-h-10 text-xs sm:mt-4 sm:min-h-12 sm:px-3 sm:text-base{% endif %}"
        aria-label="Add {{ variant.title }}: {{ product.title }}"
        {% unless variant.available %}disabled{% endunless %}
      >
        {%- if variant.available -%}Add {{ variant.title }}{%- else -%}Out of stock{%- endif -%}
      </button>
      <p data-form-error class="mt-1 text-xs text-spice" role="alert" hidden></p>
    </form>
  </div>
</article>
